diff --git a/src/context-compaction.test.ts b/src/context-compaction.test.ts
new file mode 100644
index 0000000..cd31f78
--- /dev/null
+++ b/src/context-compaction.test.ts
@@ -0,0 +1,194 @@
+import { describe, expect, it } from "vitest";
+import { ClientCapabilities, SessionNotification } from "@agentclientprotocol/sdk";
+import { ContextCompactionLifecycle } from "./context-compaction.js";
+
+function fixture(capabilities?: ClientCapabilities) {
+  const updates: SessionNotification[] = [];
+  const warnings: string[] = [];
+  const lifecycle = new ContextCompactionLifecycle(
+    async (update) => {
+      updates.push(update);
+    },
+    capabilities,
+    (message) => {
+      warnings.push(message);
+    },
+  );
+  return { updates, lifecycle, warnings };
+}
+
+describe("negotiated compaction lifecycle", () => {
+  it("emits one ID-addressed start and terminal without tool or summary payload", async () => {
+    const { updates, lifecycle } = fixture({ session: { compaction: {} } });
+    await lifecycle.start("s", "first");
+    await lifecycle.start("s", "duplicate");
+    await lifecycle.heartbeat("s", "heartbeat");
+    await lifecycle.finish("s", "terminal", "completed", { preTokens: 100 });
+    await lifecycle.finish("s", "boundary", "completed", { postTokens: 20 }, true);
+    expect(updates).toEqual([
+      {
+        sessionId: "s",
+        update: {
+          sessionUpdate: "compaction_update",
+          compactionId: "first",
+          status: "in_progress",
+        },
+      },
+      {
+        sessionId: "s",
+        update: { sessionUpdate: "compaction_update", compactionId: "first", status: "completed" },
+      },
+    ]);
+  });
+  it("allows terminal-only failure, redacts diagnostics, and opens a new attempt", async () => {
+    const { updates, lifecycle } = fixture({ session: { compaction: {} } });
+    await lifecycle.finish("s", "orphan", "failed", { error: "private context" });
+    await lifecycle.finish("s", "duplicate", "completed");
+    await lifecycle.start("s", "retry");
+    await lifecycle.finish("s", "done", "completed");
+    expect(updates.map(({ update }) => update)).toEqual([
+      { sessionUpdate: "compaction_update", compactionId: "orphan", status: "failed" },
+      { sessionUpdate: "compaction_update", compactionId: "retry", status: "in_progress" },
+      { sessionUpdate: "compaction_update", compactionId: "retry", status: "completed" },
+    ]);
+    expect(JSON.stringify(updates)).not.toContain("private context");
+  });
+  it.each([
+    undefined,
+    {},
+    { session: {} },
+    { session: { compaction: null } },
+    { session: { compaction: false } },
+    { session: { compaction: [] } },
+  ])("keeps legacy output for unsupported capability %j", async (capability) => {
+    const { updates, lifecycle } = fixture(capability as ClientCapabilities);
+    await lifecycle.start("s", "c");
+    await lifecycle.finish("s", "c", "completed");
+    expect(updates.map(({ update }) => update.sessionUpdate)).toEqual([
+      "tool_call",
+      "tool_call_update",
+    ]);
+  });
+  it("does not manufacture a successful terminal when a stream is reset", async () => {
+    const { updates, lifecycle } = fixture({ session: { compaction: {} } });
+    await lifecycle.start("s", "c");
+    lifecycle.reset();
+    expect(updates.map(({ update }) => update.sessionUpdate)).toEqual(["compaction_update"]);
+  });
+  it("fences terminal IDs against duplicate starts while allowing a distinct retry", async () => {
+    const { updates, lifecycle } = fixture({ session: { compaction: {} } });
+    await lifecycle.start("s", "attempt-1");
+    await lifecycle.finish("s", "attempt-1", "completed");
+    await lifecycle.start("s", "attempt-1");
+    await lifecycle.finish("s", "attempt-1", "failed");
+    await lifecycle.start("s", "attempt-2");
+    await lifecycle.finish("s", "attempt-2", "failed");
+    expect(updates.map(({ update }) => update)).toEqual([
+      { sessionUpdate: "compaction_update", compactionId: "attempt-1", status: "in_progress" },
+      { sessionUpdate: "compaction_update", compactionId: "attempt-1", status: "completed" },
+      { sessionUpdate: "compaction_update", compactionId: "attempt-2", status: "in_progress" },
+      { sessionUpdate: "compaction_update", compactionId: "attempt-2", status: "failed" },
+    ]);
+  });
+  it("retains ID fences across reset, including terminal-only and unresolved entities", async () => {
+    const { updates, lifecycle } = fixture({ session: { compaction: {} } });
+    await lifecycle.finish("s", "terminal-only", "completed");
+    lifecycle.reset();
+    await lifecycle.start("s", "terminal-only");
+    await lifecycle.finish("s", "terminal-only", "failed");
+    lifecycle.reset();
+    await lifecycle.start("s", "unresolved");
+    lifecycle.reset();
+    await lifecycle.start("s", "unresolved");
+    await lifecycle.finish("s", "unresolved", "completed");
+    expect(updates.map(({ update }) => update)).toEqual([
+      { sessionUpdate: "compaction_update", compactionId: "terminal-only", status: "completed" },
+      { sessionUpdate: "compaction_update", compactionId: "unresolved", status: "in_progress" },
+    ]);
+  });
+  it("fails closed when ID capacity is exhausted without evicting the oldest fence", async () => {
+    const { updates, lifecycle, warnings } = fixture({ session: { compaction: {} } });
+    for (let index = 0; index < 1024; index++) {
+      await lifecycle.start("s", `attempt-${index}`);
+      await lifecycle.finish("s", `attempt-${index}`, "completed");
+      lifecycle.reset();
+    }
+    expect(updates).toHaveLength(2048);
+    await lifecycle.start("s", "overflow");
+    await lifecycle.finish("s", "overflow", "failed");
+    lifecycle.reset();
+    await lifecycle.start("s", "attempt-0");
+    await lifecycle.finish("s", "attempt-0", "failed");
+    lifecycle.reset();
+    await lifecycle.finish("s", "terminal-overflow", "completed");
+    expect(updates).toHaveLength(2048);
+    expect(lifecycle.hasDeliveredOutput).toBe(true);
+    expect(warnings).toEqual([
+      "Compaction lifecycle ID capacity reached; suppressing additional lifecycle entities until the consumer is replaced.",
+    ]);
+  });
+  it("does not let a known stale terminal close a newer attempt", async () => {
+    const { updates, lifecycle } = fixture({ session: { compaction: {} } });
+    await lifecycle.start("s", "old");
+    await lifecycle.finish("s", "old", "completed");
+    await lifecycle.start("s", "new");
+    await lifecycle.start("s", "old");
+    await lifecycle.finish("s", "old", "failed");
+    await lifecycle.finish("s", "new", "completed");
+    expect(updates.map(({ update }) => update)).toEqual([
+      { sessionUpdate: "compaction_update", compactionId: "old", status: "in_progress" },
+      { sessionUpdate: "compaction_update", compactionId: "old", status: "completed" },
+      { sessionUpdate: "compaction_update", compactionId: "new", status: "in_progress" },
+      { sessionUpdate: "compaction_update", compactionId: "new", status: "completed" },
+    ]);
+  });
+  it.each(["failed", "completed"] as const)(
+    "fences a stale distinct terminal UUID with status %s",
+    async (status) => {
+      const { updates, lifecycle } = fixture({ session: { compaction: {} } });
+      await lifecycle.start("s", "start-1");
+      await lifecycle.finish("s", "terminal-1", "completed");
+      await lifecycle.start("s", "start-2");
+      await lifecycle.finish("s", "terminal-1", status);
+      expect(updates).toHaveLength(3);
+      await lifecycle.finish("s", "terminal-2", "completed");
+      expect(updates.map(({ update }) => update)).toEqual([
+        { sessionUpdate: "compaction_update", compactionId: "start-1", status: "in_progress" },
+        { sessionUpdate: "compaction_update", compactionId: "start-1", status: "completed" },
+        { sessionUpdate: "compaction_update", compactionId: "start-2", status: "in_progress" },
+        { sessionUpdate: "compaction_update", compactionId: "start-2", status: "completed" },
+      ]);
+    },
+  );
+  it("fences observed duplicate and enrichment UUID aliases across reset", async () => {
+    const { updates, lifecycle } = fixture({ session: { compaction: {} } });
+    await lifecycle.start("s", "start-1");
+    await lifecycle.finish("s", "terminal-1", "completed");
+    await lifecycle.finish("s", "duplicate-1", "completed");
+    await lifecycle.finish("s", "boundary-1", "completed", {}, true);
+    lifecycle.reset();
+    await lifecycle.start("s", "start-2");
+    await lifecycle.finish("s", "terminal-1", "failed");
+    await lifecycle.finish("s", "duplicate-1", "failed");
+    await lifecycle.finish("s", "boundary-1", "failed", {}, true);
+    expect(updates).toHaveLength(3);
+    await lifecycle.finish("s", "terminal-2", "completed");
+    lifecycle.reset();
+    await lifecycle.start("s", "terminal-1");
+    await lifecycle.start("s", "duplicate-1");
+    await lifecycle.start("s", "boundary-1");
+    expect(updates).toHaveLength(4);
+  });
+  it("counts distinct terminal aliases against bounded fence capacity", async () => {
+    const { updates, lifecycle, warnings } = fixture({ session: { compaction: {} } });
+    for (let index = 0; index < 512; index++) {
+      await lifecycle.start("s", `start-${index}`);
+      await lifecycle.finish("s", `terminal-${index}`, "completed");
+      lifecycle.reset();
+    }
+    await lifecycle.start("s", "overflow");
+    await lifecycle.finish("s", "overflow-terminal", "completed");
+    expect(updates).toHaveLength(1024);
+    expect(warnings).toHaveLength(1);
+  });
+});
