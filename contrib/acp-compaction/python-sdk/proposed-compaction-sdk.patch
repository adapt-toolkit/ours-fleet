+# Proposed narrow backport from the pinned unstable v1 compaction schema.
+# Keep the stable update union strict; do not replace it with arbitrary dictionaries.
+CompactionId = str
+CompactionStatus = Union[Literal["in_progress", "completed", "failed", "cancelled"], str]
+_CompactionContentBlock = Annotated[
+    Union[TextContentBlock, ImageContentBlock, AudioContentBlock, ResourceContentBlock, EmbeddedResourceContentBlock],
+    Field(discriminator="type"),
+]
+
+
+class CompactionUpdate(BaseModel):
+    """UNSTABLE compaction upsert; send only after the client's compaction capability.
+
+    Omitted summary/error/_meta leaves state unchanged; explicit null clears it.
+    Unknown string statuses are retained, never coerced into a known terminal state.
+    """
+
+    session_update: Annotated[Literal["compaction_update"], Field(alias="sessionUpdate")]
+    compaction_id: CompactionId = Field(alias="compactionId")
+    status: CompactionStatus
+    summary: Optional[List[_CompactionContentBlock]] = None
+    error: Optional[str] = None
+    field_meta: Optional[Dict[str, Any]] = Field(default=None, alias="_meta")
+
+    @model_validator(mode="after")
+    def _validate_terminal_content(self):
+        if self.summary and self.status != "completed":
+            raise ValueError("Non-empty compaction summary requires completed status")
+        if self.error is not None and self.status != "failed":
+            raise ValueError("Compaction error requires failed status")
+        return self
+
+    @model_serializer(mode="wrap")
+    def _serialize_patch(self, handler, info):
+        payload = handler(self)
+        # The SDK's serializer excludes None/defaults for ordinary payloads. Only
+        # these draft patch fields must retain an explicitly supplied null.
+        for name in ("summary", "error", "field_meta"):
+            if name in self.model_fields_set and getattr(self, name) is None:
+                alias = "_meta" if name == "field_meta" and info.by_alias else name
+                payload[alias] = None
+        return payload
+
+
+class CompactionSummaryChunk(BaseModel):
+    """UNSTABLE summary chunk; only between an in-progress and terminal update."""
+
+    session_update: Annotated[Literal["compaction_summary_chunk"], Field(alias="sessionUpdate")]
+    compaction_id: CompactionId = Field(alias="compactionId")
+    content: _CompactionContentBlock
+    field_meta: Optional[Dict[str, Any]] = Field(default=None, alias="_meta")
+
