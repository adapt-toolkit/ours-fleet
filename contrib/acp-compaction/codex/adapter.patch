+// Negotiation belongs to the ACP connection, including session history replay.
+const compactionClients = new WeakMap<AcpClientConnection, boolean>();
+
+export function configureCompaction(connection: AcpClientConnection, capabilities: acp.ClientCapabilities | null | undefined): void {
+    const capability = capabilities?.session?.compaction;
+    compactionClients.set(connection, capability !== null && typeof capability === "object" && !Array.isArray(capability));
+}
