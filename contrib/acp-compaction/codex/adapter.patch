diff --git a/src/__tests__/compaction-negotiation.test.ts b/src/__tests__/compaction-negotiation.test.ts
new file mode 100644
index 0000000..4852958
--- /dev/null
+++ b/src/__tests__/compaction-negotiation.test.ts
@@ -0,0 +1,44 @@
+import { describe, expect, it, vi } from "vitest";
+import type { ClientCapabilities } from "@agentclientprotocol/sdk";
+import { ACPSessionConnection, type AcpClientConnection } from "../ACPSessionConnection";
+import { CodexAcpServer } from "../CodexAcpServer";
+import { CodexAcpClient } from "../CodexAcpClient";
+import { CodexAppServerClient } from "../CodexAppServerClient";
+import { createMockConnections } from "./CodexACPAgent/test-utils";
+import { createContextCompactionStartUpdate, createContextCompactionCompleteUpdate, createCompletedContextCompactionUpdate } from "../CodexToolCallMapper";
+
+async function fixture(capabilities?: ClientCapabilities) {
+  const mocks = createMockConnections();
+  mocks.mockAcpConnection.notify = vi.fn().mockResolvedValue(undefined);
+  mocks.mockAcpConnection.request = vi.fn();
+  const client = new CodexAcpClient(new CodexAppServerClient(mocks.mockCodexConnection));
+  const agent = new CodexAcpServer(mocks.mockAcpConnection, client);
+  const response = await agent.initialize({ protocolVersion: 1, ...(capabilities ? { clientCapabilities: capabilities } : {}) });
+  return { response, connection: mocks.mockAcpConnection, session: new ACPSessionConnection(mocks.mockAcpConnection as AcpClientConnection, "s") };
+}
+
+describe("compaction negotiation", () => {
+  it("publishes draft updates via public notify with conservative coverage", async () => {
+    const { session, connection, response } = await fixture({ session: { compaction: {} } });
+    await session.update(createContextCompactionStartUpdate({ type: "contextCompaction", id: "c" }));
+    await session.update(createContextCompactionCompleteUpdate({ type: "contextCompaction", id: "c" }));
+    const notifications = connection.notify.mock.calls.filter((call: unknown[]) => (call[1] as { sessionId?: string })?.sessionId === "s").map((call: unknown[]) => call[1]);
+    expect(notifications).toEqual([
+      { sessionId: "s", update: { sessionUpdate: "compaction_update", compactionId: "c", status: "in_progress" } },
+      { sessionId: "s", update: { sessionUpdate: "compaction_update", compactionId: "c", status: "completed" } },
+    ]);
+    expect(response.agentCapabilities?._meta?.["ai.ours/compactionSafety"]).toEqual({ version: 1, lifecycle: "completion_only", guardedCancel: false });
+  });
+  it.each([undefined, {}, { session: {} }, { session: { compaction: null } }, { session: { compaction: false } }, { session: { compaction: [] } }])("retains legacy updates for unsupported capabilities %j", async (capabilities) => {
+    const { session, connection } = await fixture(capabilities as ClientCapabilities);
+    await session.update(createContextCompactionStartUpdate({ type: "contextCompaction", id: "c" }));
+    expect(connection.notify.mock.calls.at(-1)?.[1].update.sessionUpdate).toBe("tool_call");
+  });
+  it("maps terminal-only history without creating a start and preserves genuine tools", async () => {
+    const { session, connection } = await fixture({ session: { compaction: {} } });
+    await session.update(createCompletedContextCompactionUpdate({ type: "contextCompaction", id: "history" }));
+    expect(connection.notify.mock.calls.at(-1)?.[1]).toEqual({ sessionId: "s", update: { sessionUpdate: "compaction_update", compactionId: "history", status: "completed" } });
+    await session.update({ sessionUpdate: "tool_call", toolCallId: "real", title: "Compact conversation", kind: "think", status: "in_progress" });
+    expect(connection.notify.mock.calls.at(-1)?.[1].update.sessionUpdate).toBe("tool_call");
+  });
+});
