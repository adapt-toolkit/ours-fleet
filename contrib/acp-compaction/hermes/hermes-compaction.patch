--- /dev/null
+++ b/acp_adapter/compaction.py
@@ -0,0 +1,90 @@
+"""Negotiated, terminal-only draft compaction output.
+
+The SDK prerequisite is deliberately optional until pinned: stable SDK clients
+retain the legacy surface. No observer of prose or session rotation is used.
+"""
+from dataclasses import replace
+import logging
+import threading
+
+from agent.compaction_events import CompactionTerminal
+
+try:
+    from acp.schema import CompactionCapabilities, CompactionUpdate
+except ImportError:
+    CompactionCapabilities = CompactionUpdate = None
+
+logger = logging.getLogger(__name__)
+
+
+def supports_compaction(capabilities):
+    session = getattr(capabilities, "session", None)
+    return CompactionCapabilities is not None and isinstance(
+        getattr(session, "compaction", None), CompactionCapabilities
+    )
+
+
+class CompactionCollector:
+    """Bind one request generation, then flush terminals after outer persistence.
+
+    Capturing the callback in the runtime attempt prevents late workers from
+    attaching old attempts to a later request's collector.
+    """
+    def __init__(self, agent, conn, session_id):
+        self._agent, self._conn, self._session_id = agent, conn, session_id
+        self._missing = object()
+        self._previous = getattr(agent, "compaction_callback", self._missing)
+        self._callback = self._record
+        self._lock = threading.Lock()
+        self._events = {}
+        self._closed = False
+        self._manual_committed = False
+
+    def __enter__(self):
+        self._agent.compaction_callback = self._callback
+        return self
+
+    def __exit__(self, *_exc):
+        with self._lock:
+            self._closed = True
+        if getattr(self._agent, "compaction_callback", None) is self._callback:
+            if self._previous is self._missing:
+                del self._agent.compaction_callback
+            else:
+                self._agent.compaction_callback = self._previous
+
+    def _record(self, event):
+        if callable(self._previous):
+            try:
+                self._previous(event)
+            except Exception:
+                logger.debug("Previous compaction observer failed", exc_info=True)
+        if not isinstance(event, CompactionTerminal):
+            return
+        with self._lock:
+            if not self._closed:
+                self._events.setdefault(event.compaction_id, event)
+
+    def mark_manual_committed(self):
+        """Record the outer save before fallible response diagnostics."""
+        with self._lock:
+            self._manual_committed = True
+
+    async def flush(self, *, manual=False):
+        with self._lock:
+            events, self._events = list(self._events.values()), {}
+            manual_failed = manual and not self._manual_committed
+        if self._conn is None:
+            return
+        for event in events:
+            if manual_failed and event.status == "completed":
+                event = replace(event, status="failed")
+            try:
+                await self._conn.session_update(
+                    self._session_id,
+                    CompactionUpdate(session_update="compaction_update", compaction_id=event.compaction_id, status=event.status),
+                )
+            except Exception:
+                # An observer transport failure cannot replace a real mutation or
+                # rollback error. No complete-coverage promise is made.
+                logger.warning("Could not emit compaction terminal for ACP session %s", self._session_id, exc_info=True)
