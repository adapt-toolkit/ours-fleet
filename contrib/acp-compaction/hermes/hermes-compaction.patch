+"""Actual compression commit/abort paths expose typed, terminal-only observations."""
+import copy
+
+import pytest
+
+from agent.auxiliary_client import AuxiliaryExplicitCancellation
+from agent.conversation_compression import compress_context
+from tests.agent.test_compression_attempt_lifecycle import _build_agent, _summary_response
+
+
+@pytest.mark.parametrize("force", [False, True])
+@pytest.mark.parametrize("outcome", ["success", "failure", "cancelled", "busy", "commit_failure"])
+def test_actual_compression_terminal_matches_mutation_outcome(tmp_path, monkeypatch, force, outcome):
+    db, agent = _build_agent(tmp_path, "terminal-events")
+    events = []
+    agent.compaction_callback = events.append
+    messages = [{"role": "user" if i % 2 == 0 else "assistant", "content": f"m{i} " * 400} for i in range(20)]
+    original = copy.deepcopy(messages)
+    monkeypatch.setattr("agent.context_compressor.call_llm", lambda **kwargs: _summary_response("## Goal\nSynthetic summary."))
+    if outcome in {"failure", "cancelled"}:
+        def fail(*args, **kwargs):
+            if outcome == "cancelled":
+                agent._hard_interrupt_requested.set()
+                raise AuxiliaryExplicitCancellation()
+            raise RuntimeError("synthetic compressor failure")
+        monkeypatch.setattr(agent.context_compressor, "compress", fail)
+    if outcome == "commit_failure":
+        def fail_commit(*args, **kwargs):
+            raise RuntimeError("synthetic database commit failure")
+        monkeypatch.setattr(db, "archive_and_compact", fail_commit)
+    if outcome == "busy":
+        assert db.try_acquire_compression_lock(agent.session_id, "other-holder", ttl_seconds=60)
+    try:
+        if outcome == "failure":
+            with pytest.raises(RuntimeError, match="synthetic compressor failure"):
+                compress_context(agent, messages, "sys", approx_tokens=500_000, force=force)
+        else:
+            result, _ = compress_context(agent, messages, "sys", approx_tokens=500_000, force=force)
+            if outcome == "success":
+                assert len(result) < len(original)
+            else:
+                assert result == original
+        expected = {"success": "completed", "failure": "failed", "cancelled": "cancelled", "busy": "failed", "commit_failure": "failed"}[outcome]
+        assert [event.status for event in events] == [expected]
+        assert events[0].compaction_id
+        assert not hasattr(events[0], "summary")
+    finally:
+        db.close()
+
+
+def test_postcommit_diagnostic_error_preserves_completed_terminal(tmp_path, monkeypatch):
+    db, agent = _build_agent(tmp_path, "postcommit-terminal")
+    events = []
+    agent.compaction_callback = events.append
+    messages = [{"role": "user" if i % 2 == 0 else "assistant", "content": f"m{i} " * 400} for i in range(20)]
+    for message in messages:
+        db.append_message(agent.session_id, message["role"], message["content"])
+    monkeypatch.setattr("agent.context_compressor.call_llm", lambda **kwargs: _summary_response("## Goal\nSynthetic summary."))
+    failure = RuntimeError("postcommit diagnostic failure")
+    def fail(*args, **kwargs):
+        # The actual archive transaction has already replaced the durable history.
+        assert 0 < len(db.get_messages(agent.session_id)) < len(messages)
+        raise failure
+    monkeypatch.setattr("agent.conversation_compression._finish_compaction_boundary", fail)
+    try:
+        with pytest.raises(RuntimeError) as error:
+            compress_context(agent, messages, "sys", approx_tokens=500_000)
+        assert error.value is failure
+        assert [event.status for event in events] == ["completed"]
+        assert 0 < len(db.get_messages(agent.session_id)) < len(messages)
+    finally:
+        db.close()
