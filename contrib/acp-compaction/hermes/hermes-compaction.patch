@@ -0,0 +1,47 @@
+"""Typed terminal observations of local compression attempts, independent of UI text.
+
+These observations do not promise start coverage or guard cancellation. Native
+provider compaction may not pass through this local lifecycle.
+"""
+from dataclasses import dataclass
+import logging
+import threading
+from typing import Literal
+import uuid
+
+logger = logging.getLogger(__name__)
+
+
+@dataclass(frozen=True)
+class CompactionTerminal:
+    compaction_id: str
+    status: Literal["completed", "failed", "cancelled"]
+
+
+class CompactionTerminalReporter:
+    def __init__(self, agent, commit_fence=None):
+        self._callback = getattr(agent, "compaction_callback", None)
+        self._cancel_event = getattr(agent, "_hard_interrupt_requested", None)
+        self._commit_fence = commit_fence
+        self._id = str(uuid.uuid4())
+        self._lock = threading.Lock()
+        self._reported = False
+
+    def emit(self, commit_status):
+        with self._lock:
+            if self._reported:
+                return
+            self._reported = True
+        if not callable(self._callback):
+            return
+        # Commit is authoritative even when a later stop arrives. Aborted lease
+        # admission must never become completed just because a UI phase ended.
+        cancelled = bool(
+            (self._cancel_event is not None and self._cancel_event.is_set())
+            or (self._commit_fence is not None and self._commit_fence.is_cancelled)
+        )
+        status = "completed" if commit_status == "committed" else "cancelled" if cancelled else "failed"
+        try:
+            self._callback(CompactionTerminal(self._id, status))
+        except Exception:
+            logger.debug("Compaction observer failed", exc_info=True)
