+"""Negotiated ACP mapping over actual local automatic/manual compression paths.
+
+Draft-specific cases require the explicitly unpinned SDK prerequisite prototype.
+"""
+import threading
+from types import SimpleNamespace
+
+import pytest
+import acp.schema as schema
+from acp.schema import ClientCapabilities, TextContentBlock
+from acp.utils import serialize_params
+
+from acp_adapter.server import HermesACPAgent
+from acp_adapter.session import SessionManager, SessionState
+from tests.agent.test_compression_attempt_lifecycle import _build_agent, _summary_response
+
+pytestmark = [pytest.mark.asyncio, pytest.mark.skipif(not hasattr(schema, "CompactionUpdate"), reason="draft SDK prerequisite not pinned")]
+
+
+@pytest.fixture
+def compression_session(tmp_path, monkeypatch):
+    db, runtime = _build_agent(tmp_path, "acp-compaction")
+    history = [{"role": "user" if i % 2 == 0 else "assistant", "content": f"m{i} " * 400} for i in range(20)]
+    state = SessionState("acp-compaction", runtime, history=history, cancel_event=threading.Event())
+    manager = SessionManager(db=db)
+    manager._sessions[state.session_id] = state
+    adapter = HermesACPAgent(manager)
+    wire, order = [], []
+    async def update(session_id, update):
+        payload = serialize_params(update)
+        wire.append(payload)
+        if payload.get("sessionUpdate") == "compaction_update":
+            order.append("compaction:" + payload["status"])
+    async def permission(*args, **kwargs):
+        raise AssertionError("no permission request expected")
+    adapter._conn = SimpleNamespace(session_update=update, request_permission=permission)
+    monkeypatch.setattr("agent.context_compressor.call_llm", lambda **kwargs: _summary_response("## Goal\nSynthetic summary."))
+    def automatic(**kwargs):
+        messages, _ = runtime._compress_context(kwargs["conversation_history"], "sys", approx_tokens=500_000)
+        return {"messages": messages, "final_response": "done"}
+    monkeypatch.setattr(runtime, "run_conversation", automatic)
+    save = manager.save_session
+    def saved(session_id):
+        save(session_id)
+        order.append("saved")
+    monkeypatch.setattr(manager, "save_session", saved)
+    yield adapter, state, wire, order
+    db.close()
+
+
+async def initialize(adapter, capability):
+    caps = {"auth": {"terminal": False}}
+    if capability == "enabled":
+        caps["session"] = {"compaction": {}}
+    elif capability == "null":
+        caps["session"] = {"compaction": None}
+    return await adapter.initialize(client_capabilities=ClientCapabilities.model_validate(caps))
+
+
+def terminals(wire):
+    return [item for item in wire if item.get("sessionUpdate") == "compaction_update"]
+
+
+@pytest.mark.parametrize("manual", [False, True])
+@pytest.mark.parametrize("capability", ["enabled", "absent", "null"])
+async def test_actual_mutation_is_visible_only_when_negotiated(compression_session, capability, manual):
+    adapter, state, wire, order = compression_session
+    response = await initialize(adapter, capability)
+    before = len(state.history)
+    result = await adapter.prompt([TextContentBlock(type="text", text="/compress" if manual else "continue")], state.session_id)
+    assert result.stop_reason == "end_turn"
+    assert len(state.history) < before
+    events = terminals(wire)
+    if capability == "enabled":
+        assert [event["status"] for event in events] == ["completed"]
+        assert set(events[0]) == {"sessionUpdate", "compactionId", "status"}
+        assert order.index("saved") < order.index("compaction:completed")
+        assert response.agent_capabilities.field_meta["ai.ours/compactionSafety"] == {
+            "version": 1, "lifecycle": "completion_only", "guardedCancel": False,
+        }
+    else:
+        assert events == []
+        assert response.agent_capabilities.field_meta is None
+
+
+@pytest.mark.parametrize("manual", [False, True])
+async def test_compression_failure_is_never_completed(compression_session, monkeypatch, manual):
+    adapter, state, wire, order = compression_session
+    await initialize(adapter, "enabled")
+    def fail(*args, **kwargs):
+        raise RuntimeError("synthetic summary failure")
+    monkeypatch.setattr(state.agent.context_compressor, "compress", fail)
+    with pytest.raises(Exception):
+        await adapter.prompt([TextContentBlock(type="text", text="/compress" if manual else "continue")], state.session_id)
+    assert [event["status"] for event in terminals(wire)] == ["failed"]
+    assert not state.is_running
+
+
+async def test_manual_outer_save_failure_does_not_publish_completion(compression_session, monkeypatch):
+    adapter, state, wire, order = compression_session
+    await initialize(adapter, "enabled")
+    def fail(*args, **kwargs):
+        raise RuntimeError("synthetic persistence failure")
+    monkeypatch.setattr(adapter.session_manager, "save_session", fail)
+    with pytest.raises(Exception):
+        await adapter.prompt([TextContentBlock(type="text", text="/compress")], state.session_id)
+    assert [event["status"] for event in terminals(wire)] == ["failed"]
+    assert not state.is_running
+
+
+async def test_duplicate_and_late_terminals_do_not_cross_request_generations():
+    from acp_adapter.compaction import CompactionCollector
+    from agent.compaction_events import CompactionTerminalReporter
+    agent = SimpleNamespace()
+    updates = []
+    async def send(session_id, update):
+        updates.append(serialize_params(update))
+    connection = SimpleNamespace(session_update=send)
+    with CompactionCollector(agent, connection, "s1") as first:
+        stale = CompactionTerminalReporter(agent)
+        completed = CompactionTerminalReporter(agent)
+        completed.emit("committed")
+        completed.emit("committed")
+    with CompactionCollector(agent, connection, "s1") as second:
+        stale.emit("committed")
+        fresh = CompactionTerminalReporter(agent)
+        fresh.emit("committed")
+    await first.flush()
+    await first.flush()
+    await second.flush()
+    assert [item["status"] for item in updates] == ["completed", "completed"]
+    assert updates[0]["compactionId"] != updates[1]["compactionId"]
+    assert not hasattr(agent, "compaction_callback")
+
+
+@pytest.mark.parametrize("manual", [False, True])
+async def test_actual_cancelled_summary_emits_cancelled(compression_session, monkeypatch, manual):
+    from agent.auxiliary_client import AuxiliaryExplicitCancellation
+    adapter, state, wire, order = compression_session
+    await initialize(adapter, "enabled")
+    def cancel(*args, **kwargs):
+        state.cancel_event.set()
+        state.agent._hard_interrupt_requested.set()
+        raise AuxiliaryExplicitCancellation()
+    monkeypatch.setattr(state.agent.context_compressor, "compress", cancel)
+    response = await adapter.prompt([TextContentBlock(type="text", text="/compress" if manual else "continue")], state.session_id)
+    assert response.stop_reason == "cancelled"
+    assert [event["status"] for event in terminals(wire)] == ["cancelled"]
+    assert not state.is_running
+
+
+async def test_manual_postsave_diagnostic_failure_preserves_completed(compression_session, monkeypatch):
+    from acp.exceptions import RequestError
+    import acp_adapter.commands as commands
+    adapter, state, wire, order = compression_session
+    await initialize(adapter, "enabled")
+    estimate = commands._estimate_tokens
+    failure = RuntimeError("postsave diagnostic failure")
+    calls = 0
+    def diagnostic(*args, **kwargs):
+        nonlocal calls
+        calls += 1
+        if calls == 2:
+            assert "saved" in order
+            raise failure
+        return estimate(*args, **kwargs)
+    monkeypatch.setattr(commands, "_estimate_tokens", diagnostic)
+    with pytest.raises(RequestError) as error:
+        await adapter.prompt([TextContentBlock(type="text", text="/compress")], state.session_id)
+    assert error.value.__cause__ is failure
+    assert [event["status"] for event in terminals(wire)] == ["completed"]
+    assert order.index("saved") < order.index("compaction:completed")
+    assert not state.is_running
