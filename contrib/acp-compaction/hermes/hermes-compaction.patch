+"""Exercise the actual prompt/executor/finalization lifecycle without a model API."""
+import asyncio
+import threading
+from types import SimpleNamespace
+
+import pytest
+from acp.exceptions import RequestError
+from acp.schema import TextContentBlock
+
+from acp_adapter.server import HermesACPAgent
+from acp_adapter.session import SessionManager, SessionState
+
+
+class Runtime:
+    session_id = "head"
+
+    def __init__(self):
+        self.calls = []
+        self.result = {"final_response": "done", "messages": []}
+        self.failure = None
+
+    def run_conversation(self, **kwargs):
+        self.calls.append(kwargs["user_message"])
+        if self.failure:
+            raise self.failure
+        return self.result
+
+
+@pytest.fixture
+def setup():
+    runtime = Runtime()
+    state = SessionState("test", runtime, cancel_event=threading.Event())
+    manager = SessionManager()
+    manager._sessions[state.session_id] = state
+    return HermesACPAgent(manager), state, runtime
+
+
+async def send(adapter, text="hello"):
+    return await adapter.prompt([TextContentBlock(type="text", text=text)], "test")
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("boundary", ["callbacks", "persist", "output", "usage"])
+async def test_failure_releases_ownership_and_next_request_runs(setup, monkeypatch, boundary):
+    adapter, state, runtime = setup
+    def fail(*args, **kwargs):
+        raise RuntimeError("injected failure")
+    async def async_fail(*args, **kwargs):
+        fail()
+    with monkeypatch.context() as fault:
+        if boundary == "callbacks":
+            fault.setattr(adapter, "_wire_turn_callbacks", fail)
+        elif boundary == "persist":
+            runtime.result["messages"] = [{"role": "assistant", "content": "done"}]
+            fault.setattr(adapter.session_manager, "save_session", fail)
+        elif boundary == "output":
+            adapter._conn = SimpleNamespace(session_update=async_fail, request_permission=async_fail)
+        else:
+            fault.setattr(adapter, "_send_usage_update", async_fail)
+        with pytest.raises(RuntimeError, match="injected failure"):
+            await send(adapter)
+        assert not state.is_running
+        assert state.current_prompt_text == ""
+    adapter._conn = None
+    runtime.result["messages"] = []
+    assert (await send(adapter, "next")).stop_reason == "end_turn"
+    assert runtime.calls[-1] == "next"
+
+
+@pytest.mark.asyncio
+async def test_runtime_error_is_not_success(setup):
+    adapter, state, runtime = setup
+    runtime.failure = RuntimeError("model failed")
+    with pytest.raises(RuntimeError, match="model failed"):
+        await send(adapter)
+    assert not state.is_running
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("text", ["later", "/queue later", "/steer later", "/QUEUE later", "//queue later", "/STEER later"])
+async def test_busy_requests_remain_client_owned(setup, text):
+    adapter, state, runtime = setup
+    state.is_running = True
+    with pytest.raises(RequestError) as error:
+        await send(adapter, text)
+    assert error.value.data["reason"] == "session_busy"
+    assert not state.queued_prompts
+    assert not runtime.calls
+    assert state.is_running
+
+
+@pytest.mark.asyncio
+async def test_idle_queue_executes_before_receipt(setup):
+    adapter, state, runtime = setup
+    assert (await send(adapter, "/queue later")).stop_reason == "end_turn"
+    assert runtime.calls == ["later"]
+    assert not state.queued_prompts
+
+
+@pytest.mark.asyncio
+async def test_cancel_is_coalesced_and_idle_is_noop(setup, monkeypatch):
+    adapter, state, runtime = setup
+    interrupts = []
+    monkeypatch.setattr("acp_adapter.server.request_hard_interrupt", lambda agent: interrupts.append(agent))
+    await adapter.cancel("test")
+    assert not state.cancel_event.is_set()
+    assert interrupts == []
+    state.is_running = True
+    await adapter.cancel("test")
+    await adapter.cancel("test")
+    assert interrupts == [runtime]
+
+
+@pytest.mark.asyncio
+async def test_ownership_covers_usage_output(setup, monkeypatch):
+    adapter, state, runtime = setup
+    entered, release = asyncio.Event(), asyncio.Event()
+    async def usage(_state):
+        entered.set()
+        await release.wait()
+    monkeypatch.setattr(adapter, "_send_usage_update", usage)
+    task = asyncio.create_task(send(adapter))
+    try:
+        await asyncio.wait_for(entered.wait(), 5)
+        assert state.is_running
+        with pytest.raises(RequestError):
+            await send(adapter, "later")
+    finally:
+        release.set()
+        await task
+    assert not state.is_running
+
+
+@pytest.mark.asyncio
+async def test_task_cancellation_keeps_ownership_until_worker_stops(setup, monkeypatch):
+    adapter, state, runtime = setup
+    loop = asyncio.get_running_loop()
+    entered, interrupted = asyncio.Event(), asyncio.Event()
+    release = threading.Event()
+    def run(**kwargs):
+        loop.call_soon_threadsafe(entered.set)
+        assert release.wait(5)
+        return {"messages": [], "interrupted": True}
+    monkeypatch.setattr(runtime, "run_conversation", run)
+    monkeypatch.setattr("acp_adapter.server.request_hard_interrupt", lambda agent: interrupted.set())
+    task = asyncio.create_task(send(adapter))
+    try:
+        await asyncio.wait_for(entered.wait(), 5)
+        task.cancel()
+        await asyncio.wait_for(interrupted.wait(), 5)
+        assert state.is_running
+        with pytest.raises(RequestError):
+            await send(adapter, "later")
+        task.cancel()
