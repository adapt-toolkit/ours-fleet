exports[`owner-channel room subcommands > snapshots the Markdown room list/show/recovery integration surface 1`] = `
[
  "## 🏠 Rooms

- ⏳ Provisioning \`<ROOM_ID>\` — test room",
  "## 🏠 Room details

- **ID:** \`<ROOM_ID>\`

- **Name:** test room

- **Status:** ⏳ Provisioning

- **Saga:** persist\\_intent (step 0)

- **Created:** \`<ISO_DATE>\`",
  "## 🛟 Room recovery

- **Room:** \`<ROOM_ID>\`

- **Status:** ⏳ Provisioning

- **Saga:** \`persist_intent\`

### Next step
- No recovery action is needed.",
]
`;

exports[`owner-channel task subcommands > snapshots the Markdown task lifecycle integration surface 1`] = `
